DATABASE_URL=postgresql+psycopg://invoice_app:postgres@localhost:5432/invoice_filter
RUNTIME_DIR=runtime
# Vietnamese-capable embeddings; numeric identifiers are checked separately by rules.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL_CACHE=runtime/models
EMBEDDING_CACHE=runtime/embeddings.sqlite
EMBEDDING_DEVICE=cpu
EMBEDDING_THREADS=4
EMBEDDING_BATCH_SIZE=32
# NER for reconciliation and aliases in confirmed learning. Inference stays local.
NER_ENABLED=true
NER_MODEL=NlpHUST/ner-vietnamese-electra-base
NER_REVISION=main
NER_MODEL_CACHE=runtime/models/ner
NER_DEVICE=cpu
NER_MIN_SCORE=0.85
NER_BATCH_SIZE=8
AUTO_THRESHOLD=0.90
REVIEW_THRESHOLD=0.60
# Minimum evidence-score gap between competing customers (precision guard).
MATCH_MARGIN=0.08
CANDIDATE_LIMIT=40
BATCH_SIZE=1000
